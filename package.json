{
  "name": "dashboard-ta-jagofarm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "db:migrate": "npm run api -- migrate",
    "db:admin": "npm run api -- admin",
    "db:size": "npm run api -- size",
    "simulator": "node --env-file-if-exists=.env --import tsx server/features/kelola-iot/simulator.ts",
    "typecheck": "tsc -p server/tsconfig.json",
    "test:pilot": "node --env-file-if-exists=.env --import tsx --test tests/server/pilot/pilot.test.ts tests/server/database/db.test.ts",
    "test:v1": "node --env-file-if-exists=.env --import tsx --test server/v1.test.ts",
    "test:vpet": "node --test tests/v-pet/pet-model.test.mjs tests/v-pet/pet-condition.test.mjs tests/v-pet/pet-progression.test.mjs tests/kelola-area/fish-population.test.mjs tests/v-pet/pet-character-levels.test.mjs tests/v-pet/kangkung-sensor-exp.test.mjs tests/v-pet/pet-quests.test.mjs tests/gamifikasi/mission-navigation.test.mjs tests/gamifikasi/pond-activity-rewards.test.mjs tests/gamifikasi/pond-activity-state.test.mjs",
    "test:qr": "node --test tests/detail-information/qr-scanner.test.mjs",
    "cek:aset": "python scripts/v-pet/cek-aset.py"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@scalar/fastify-api-reference": "1.75.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.3",
    "jsqr": "1.4.0",
    "nodemailer": "^10.0.9",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
