# Replace 192.168.1.20 with the Windows Wi-Fi IPv4 address.
# HTTP is unencrypted; use only on a trusted LAN. Database and Mailpit stay loopback-bound.
JAGOFARM_WEB_BIND=192.168.1.20
JAGOFARM_APP_ORIGIN=http://192.168.1.20:8080,http://127.0.0.1:8080,http://localhost:8080
JAGOFARM_ALLOW_LAN_HTTP_ORIGIN=true
