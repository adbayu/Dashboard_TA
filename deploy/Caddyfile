{
	# Dikunci ke Let's Encrypt supaya Caddy tidak pindah diam-diam ke CA lain.
	# Root CA yang ditanam di firmware (firmware/include/root_ca.h) harus cocok dengan rantai ini.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

{$SITE_ADDRESS} {
	header {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob: https://images.unsplash.com; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-p8afluEvtSoLeWA0esTUo4HITwBEx9d/icIWHJYJnxY='; connect-src 'self'; worker-src 'self' blob:"
		-Server
	}

	@backend path /api/* /docs /docs/*
	handle @backend {
		# flush_interval -1 wajib supaya SSE (/api/v1/stream) tidak tertahan buffer.
		reverse_proxy api:3001 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		encode zstd gzip

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
