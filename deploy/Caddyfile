{
	# Dikunci ke Let's Encrypt supaya Caddy tidak pindah diam-diam ke CA lain.
	# Root CA yang ditanam di firmware (firmware/include/root_ca.h) harus cocok dengan rantai ini.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

{$SITE_ADDRESS} {
	header {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		-Server
	}

	@backend path /api/* /docs /docs/*
	handle @backend {
		# flush_interval -1 wajib supaya SSE (/api/v1/stream) tidak tertahan buffer.
		reverse_proxy api:3001 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		encode zstd gzip

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
