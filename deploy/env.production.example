# Salin menjadi deploy/.env di VPS, lalu chmod 600. File .env tidak boleh di-commit.

# Domain atau subdomain yang A recordnya mengarah ke IP VPS. Tanpa https:// dan tanpa slash.
DOMAIN=iot.contoh.com

# Buat dengan: openssl rand -hex 24
POSTGRES_PASSWORD=

# Opsional. Kalau kosong, email undangan masuk ke Mailpit (lihat komentar di compose.yaml).
# Untuk SMTP asli isi semuanya. Port 587 memakai STARTTLS, port 465 butuh SMTP_SECURE=true.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
