# Local Docker Compose settings only. The database remains loopback-bound.
JAGOFARM_DB_PASSWORD=pilot-local-only
JAGOFARM_DB_PORT=5433
JAGOFARM_SMTP_PORT=1025
JAGOFARM_WEB_PORT=8080
JAGOFARM_WEB_BIND=127.0.0.1
JAGOFARM_MAIL_UI_PORT=8025
JAGOFARM_APP_ORIGIN=http://127.0.0.1:8080
JAGOFARM_ALLOW_LAN_HTTP_ORIGIN=false
JAGOFARM_NODE_ENV=development
JAGOFARM_SMTP_FROM=no-reply@jagofarm.local

# Optional: fill these before running the admin-init profile.
JAGOFARM_ADMIN_EMAIL=
JAGOFARM_ADMIN_PASSWORD=
