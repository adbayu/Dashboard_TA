DATABASE_URL=postgresql://pilot:pilot-local-only@localhost:5432/jagofarm
APP_ORIGIN=http://localhost:5173
# Development only: host tambahan Vite, pisahkan dengan koma. Jangan pakai '*' untuk seluruh host.
# DEV_ALLOWED_HOSTS=nama-subdomain.trycloudflare.com
HOST=127.0.0.1
PORT=3001
# Production di belakang reverse proxy (Caddy): isi 1 supaya rate limit memakai IP klien asli.
# Jangan isi kalau API bisa dijangkau langsung dari internet.
# TRUST_PROXY_HOPS=1
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=pilot@jagofarm.test
# Production: NODE_ENV=production, APP_ORIGIN=https://your-dashboard-host
# SMTP_USER and SMTP_PASS optional; SMTP_SECURE=true for TLS on port 465.
